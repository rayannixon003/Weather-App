@page "/profile"
@inject WeatherApp.Frontend.Services.AuthService AuthService
@inject NavigationManager Navigation

@using WeatherApp.Frontend.Models

<div class="profile-container">
    <h3 class="profile-title">👤 User Profile</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (user != null)
    {
        <div class="profile-card">
            <h4 class="profile-name">@(string.IsNullOrWhiteSpace(user.Name) ? "User" : user.Name)</h4>
            <p class="profile-detail"><strong>Email:</strong> @user.Email</p>
            <p class="profile-detail"><strong>Phone:</strong> @user.Phone</p>

            <!-- Logout Button -->
            <button class="logout-btn" @onclick="LogoutUser">🚪 Logout</button>
        </div>
    }
    else
    {
        <p class="text-warning text-center">⚠️ User not found. Please log in again.</p>
    }
</div>

<style>
    /* Dark background */
    body {
        background-color: #1E1E2F;
        color: white;
        font-family: Arial, sans-serif;
    }

    .profile-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        text-align: center;
    }

    .profile-title {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #FFD700; /* Gold color */
    }

    /* Profile Card Styling */
    .profile-card {
        background: #F8F9FA; /* Light Gray */
        color: black; /* Visible text */
        padding: 35px;
        border-radius: 12px;
        width: 450px;
        box-shadow: 0px 6px 15px rgba(255, 255, 255, 0.15);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-align: left;
    }

        .profile-card:hover {
            transform: translateY(-6px);
            box-shadow: 0px 8px 20px rgba(255, 255, 255, 0.25);
        }

    /* Text Alignment */
    .profile-name {
        text-align: center;
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .profile-detail {
        font-size: 17px;
        margin: 5px 0;
    }

    /* Logout button */
    .logout-btn {
        display: block;
        width: 100%;
        background: #DC3545;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        margin-top: 15px;
        transition: background 0.3s ease;
        text-align: center;
    }

        .logout-btn:hover {
            background: #C82333;
        }
</style>

@code {
    private UserModel? user;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await AuthService.GetUserData();
            Console.WriteLine($"User Data: Name={user?.Name}, Email={user?.Email}, Phone={user?.Phone}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching user profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LogoutUser()
    {
        await AuthService.LogoutUser();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
