{
  "openapi": "3.0.1",
  "info": {
    "title": "WeatherApp.Backend",
    "version": "1.0"
  },
  "paths": {
    "/api/historicalweather/save": {
      "post": {
        "tags": [
          "HistoricalWeather"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalWeatherModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalWeatherModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalWeatherModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/historicalweather/get": {
      "get": {
        "tags": [
          "HistoricalWeather"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoricalWeatherModel"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoricalWeatherModel"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoricalWeatherModel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/weather/get": {
      "get": {
        "tags": [
          "Weather"
        ],
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HistoricalWeatherModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "temperature": {
            "type": "number",
            "format": "double"
          },
          "humidity": {
            "type": "integer",
            "format": "int32"
          },
          "weatherDescription": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}